#include <errno.h>
#include <signal.h>
#include <stdio.h>
#include <string.h>
#include <sys/resource.h>
#include <sys/time.h>
#include <sys/types.h>
#include <unistd.h>
#include <sys/mman.h>
#include <time.h>
#include <math.h>
#include <sched.h> 

#include "ecrt.h"

/****************************************************************************/

/* 任务参数 */
#define TASK_FREQUENCY       1000  /* 1kHz = 1ms */
#define PERIOD_NS            (1000000000 / TASK_FREQUENCY)
#define TIMESPEC2NS(T) ((uint64_t) (T).tv_sec * 1000000000 + (T).tv_nsec)

/* 运动参数 */
#define VELOCITY_AMPLITUDE   100000 /* 速度幅值 */

/* EtherCAT 对象 */
static ec_master_t *master = NULL;
static ec_domain_t *domain1 = NULL;
static ec_slave_config_t *sc_hpm = NULL;
static uint8_t *domain1_pd = NULL;

/* HPM 身份信息 */
#define HPM_ALIAS      0, 0
#define HPM_VID_PID    0x0048504d, 0x00000004

/****************************************************************************/

/* 偏移量 */
static struct {
    unsigned int ctrl_word;
    unsigned int target_velocity;
    unsigned int status_word;
    unsigned int act_position;
} offset;

/* 1. 变量注册表 (关联 C 变量到 PDO) */
const static ec_pdo_entry_reg_t domain1_regs[] = {
    {HPM_ALIAS, HPM_VID_PID, 0x6040, 0, &offset.ctrl_word},
    {HPM_ALIAS, HPM_VID_PID, 0x60FF, 0, &offset.target_velocity},
    {HPM_ALIAS, HPM_VID_PID, 0x6041, 0, &offset.status_word},
    {HPM_ALIAS, HPM_VID_PID, 0x6064, 0, &offset.act_position},
    {}
};

/* 2. PDO 结构定义 (关键：必须严格照抄 dmesg 日志里的默认结构) */

// RxPDO (主站 -> 从站)
static ec_pdo_entry_info_t hpm_pdo_entries_rx[] = {
    {0x6040, 0x00, 16}, // Control Word
    {0x60ff, 0x00, 32}, // Target Velocity
    {0x0000, 0x00, 16}, // Gap (填充位，必须加上！)
};

// TxPDO (从站 -> 主站)
static ec_pdo_entry_info_t hpm_pdo_entries_tx[] = {
    {0x6041, 0x00, 16}, // Status Word
    {0x6064, 0x00, 32}, // Actual Position
    {0x0000, 0x00, 16}, // Gap (填充位，必须加上！)
};

// PDO 组装
static ec_pdo_info_t hpm_pdos[] = {
    // 使用默认索引 0x1602 和 0x1A02
    {0x1602, 3, hpm_pdo_entries_rx}, 
    {0x1A02, 3, hpm_pdo_entries_tx}
};

// Sync Manager 配置
static ec_sync_info_t hpm_syncs[] = {
    { 0, EC_DIR_OUTPUT, 0, NULL, EC_WD_DISABLE },
    { 1, EC_DIR_INPUT, 0, NULL, EC_WD_DISABLE },
    { 2, EC_DIR_OUTPUT, 1, hpm_pdos + 0, EC_WD_ENABLE }, // SM2 -> RxPDO
    { 3, EC_DIR_INPUT, 1, hpm_pdos + 1, EC_WD_DISABLE }, // SM3 -> TxPDO
    { 0xFF }
};

/**************************************************************************/

void cyclic_task(struct timespec *wakeup_time)
{
    static uint16_t command = 0x0000;
    static int32_t target_vel = 0;
    static int counter = 0;
    
    uint16_t status;
    int32_t act_pos;

    // 1. DC Sync
    ecrt_master_application_time(master, TIMESPEC2NS(*wakeup_time));

    // 2. 接收
    ecrt_master_receive(master);
    ecrt_domain_process(domain1);

    // 3. 读取
    status = EC_READ_U16(domain1_pd + offset.status_word);
    act_pos = EC_READ_S32(domain1_pd + offset.act_position);

    // 4. 状态机逻辑
    if (status & 0x0008) { // Fault
        command = 0x0080;
        target_vel = 0;
    }
    else if ((status & 0x004F) == 0x0040) { // Switch On Disabled
        command = 0x0006;
    }
    else if ((status & 0x006F) == 0x0021) { // Ready to Switch On
        command = 0x0007;
    }
    else if ((status & 0x006F) == 0x0023) { // Switched On
        command = 0x000F;
    }
    else if ((status & 0x006F) == 0x0027) { // Operation Enabled
        command = 0x000F;
        
        // 正弦波速度
        double phase = (double)(counter % 2000) / 2000.0 * 2.0 * 3.14159;
        target_vel = (int32_t)(VELOCITY_AMPLITUDE * sin(phase));
    }
    else {
        command = 0x0000;
        target_vel = 0;
    }

    // 5. 写入
    EC_WRITE_U16(domain1_pd + offset.ctrl_word, command);
    EC_WRITE_S32(domain1_pd + offset.target_velocity, target_vel);

    if (counter % 500 == 0) {
        printf("CSV: Sts=0x%04X | Cmd=0x%04X | ActPos=%d | TgtVel=%d\n", 
               status, command, act_pos, target_vel);
    }

    // 6. Sync
    ecrt_master_sync_reference_clock(master);
    ecrt_master_sync_slave_clocks(master);

    // 7. 发送
    ecrt_domain_queue(domain1);
    ecrt_master_send(master);
    
    counter++;
}

/****************************************************************************/

int main(int argc, char **argv)
{
    printf("Starting HPM CSV (Fixed Mapping)...\n");

    master = ecrt_request_master(0);
    if (!master) exit(EXIT_FAILURE);

    domain1 = ecrt_master_create_domain(master);
    if (!domain1) exit(EXIT_FAILURE);

    if (!(sc_hpm = ecrt_master_slave_config(master, HPM_ALIAS, HPM_VID_PID))) {
        fprintf(stderr, "Failed to get slave config!\n");
        exit(EXIT_FAILURE);
    }

    // --- 1. 配置 DC (Shift=0) ---
    ecrt_slave_config_dc(sc_hpm, 0x0300, PERIOD_NS, 0, 0, 0);

    // --- 2. 配置 PDO (显式传入默认结构) ---
    // 这样既满足了主站库的定义需求，又满足了从站"不可修改"的要求，因为我们配的一模一样。
    if (ecrt_slave_config_pdos(sc_hpm, EC_END, hpm_syncs)) {
        fprintf(stderr, "Failed to configure PDOs!\n");
        exit(EXIT_FAILURE);
    }

    // --- 3. 强制 SDO 模式为 CSV (9) ---
    ecrt_slave_config_sdo8(sc_hpm, 0x6060, 0, 9);

    // --- 4. 注册 PDO ---
    if (ecrt_domain_reg_pdo_entry_list(domain1, domain1_regs)) {
        fprintf(stderr, "PDO registration failed! (Still mismatch?)\n");
        exit(EXIT_FAILURE);
    }

    printf("Activating master...\n");
    if (ecrt_master_activate(master)) exit(EXIT_FAILURE);

    if (!(domain1_pd = ecrt_domain_data(domain1))) exit(EXIT_FAILURE);

    // 实时优先级
    struct sched_param param;
    param.sched_priority = 49;
    sched_setscheduler(0, SCHED_FIFO, &param);

    struct timespec wakeup_time;
    clock_gettime(CLOCK_MONOTONIC, &wakeup_time);
    wakeup_time.tv_sec += 1; 

    while (1) {
        wakeup_time.tv_nsec += PERIOD_NS;
        while (wakeup_time.tv_nsec >= 1000000000) {
            wakeup_time.tv_nsec -= 1000000000;
            wakeup_time.tv_sec++;
        }
        clock_nanosleep(CLOCK_MONOTONIC, TIMER_ABSTIME, &wakeup_time, NULL);
        cyclic_task(&wakeup_time);
    }

    return EXIT_SUCCESS;
}
